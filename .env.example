# Copy to .env and fill in. Never commit .env.

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://biletflow:biletflow@localhost:5432/biletflow?schema=public"

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Tickets ------------------------------------------------------------------
# HMAC key for admission QR signatures. Generate with: openssl rand -hex 32
# Rotating this invalidates every previously issued ticket QR code.
TICKET_SIGNING_KEY=""
# HMAC key for opaque campaign QR tokens.
CAMPAIGN_SIGNING_KEY=""

# --- Email --------------------------------------------------------------------
# Development uses the Mailpit container; no provider account needed.
EMAIL_TRANSPORT="smtp"
SMTP_HOST="localhost"
SMTP_PORT="1025"
EMAIL_FROM="BiletFlow <no-reply@biletflow.local>"
# Production only, when EMAIL_TRANSPORT=resend
RESEND_API_KEY=""

# --- Object storage (MinIO in development) ------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="biletflow"
S3_SECRET_KEY="biletflow"
S3_BUCKET="biletflow-uploads"
S3_FORCE_PATH_STYLE="true"

# --- Application --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ru"

# --- Business rules (seeded into PlatformSetting, admin-editable at runtime) ---
PLATFORM_ACTIVATION_FEE_KZT="15000"
PLATFORM_FEE_PERCENT="3.5"
PLATFORM_FEE_FIXED_KZT="100"
CHECKOUT_HOLD_MINUTES="15"

# --- Payments -----------------------------------------------------------------
# "simulated" is the only supported value for the academic build.
PAYMENT_PROVIDER="simulated"
PAYMENT_WEBHOOK_SECRET=""
